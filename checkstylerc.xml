<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="severity" value="warning" />

    <!-- Limitar a 80 caracteres por línea, excepto para los imports y comentarios -->
    <module name="LineLength">
        <property name="max" value="80" />
        <property name="ignorePattern" value="^import.*|^\s*//.*|^\s*/\*.*\*/\s*$|^\s*\*\s.*" />
    </module>

    <!-- Rechazar uso de tabulaciones -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true" />
    </module>

    <module name="NewlineAtEndOfFile" />

    <!-- Suprimir reglas específicas desde archivo externo -->
    <module name="SuppressionFilter">
        <property name="file" value="./suppressions.xml" />
        <property name="optional" value="false" />
    </module>

    <module name="TreeWalker">

        <!-- Nombres de variables en camelCase -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$" />
        </module>

        <!-- Constantes en mayúsculas y snake_case -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9_]*$" />
        </module>

        <!-- Envoltura de separadores -->
        <module name="SeparatorWrap">
            <property name="tokens" value="METHOD_REF" />
            <property name="option" value="nl" />
        </module>

        <!-- Longitud máxima de métodos -->
        <module name="MethodLength">
            <property name="max" value="50" />
        </module>

        <module name="NoWhitespaceAfter" />
        <module name="NoWhitespaceBefore" />
        <module name="OneStatementPerLine" />
        <module name="OperatorWrap" />
        <module name="RightCurly" />
        <module name="WhitespaceAround" />

    </module>
</module>